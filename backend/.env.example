PORT=5003
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Razorpay API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Security & Feature Flags (Development Bypasses)
ENABLE_LOGIN_RATE_LIMIT=true    # Set to false in dev/testing to bypass authLimiter (defaults to true if omitted)
ENABLE_ACCOUNT_LOCK=true        # Set to false in dev to bypass 5-failed-attempts account lockout
ENABLE_EMAIL_VERIFICATION=true  # Set to false in dev to allow unverified email logins
ENABLE_ROLE_SELECTION=true      # Set to false in dev to bypass role selection landing redirect

GEMINI_API_KEY=your_gemini_api_key
